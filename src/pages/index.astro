---
import BaseLayout from '../layouts/Baselayout.astro';
import Greeting from '../components/Greeting';
const { pageTitle } = Astro.props;
---
<BaseLayout pageTitle={pageTitle}>
  <h2>Hoy soñe con ella, ya no me sueño junto a ella pero sigo viendola...</h2>
    <Greeting client:load messages={["Como te ha ido?", "Te extraño", "Sigues siendo tú?", "Haz pensado en mi?", "Vas a regresar?"]} />

</BaseLayout>