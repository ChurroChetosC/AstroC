---
import BaseLayout from '../layouts/Baselayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';
import BlogPost from '../components/BlogPost.astro';


const pageTitle = "Blog";
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const { pagetitle } = Astro.props;
---
<BaseLayout pageTitle={pageTitle}>
     <h1>Esta es la tercera página</h1>
        <h2>Estoy hambriento    </h2>
        <h3>Extraño a mi ex pero debo tener caracteeso es lo q me sapara de un mediocre, si no puedo lidiar con esto ahorita no estare preparado para un futuro </h3>
     <ul>
    {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}

    </ul>
</BaseLayout>

   
