---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';
import BaseLayout from '../layouts/Baselayout.astro';

const {pageTitle} = Astro.props;

const identity = {
  firstName: "César",
  country: "Mexico",
  occupation: "Deportista y Desarrollador",
  hobbies: ["Entrenar", "Videojuegos", "Leer", "Ver series", "Aprender cosas nuevas"],
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro", "Redacción de documentos", "Superacion", "Lidiar con ruptura amorosa", "Comunicación efectiva", "Seremos mejores"];

const happy = true;
const finished = true;
const goal = 3;
const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";

---

	  <BaseLayout pageTitle={pageTitle}>
	 <style define:vars={{skillColor, fontWeight, textCase}}>
  h1 {	
    color: purple;
    font-size: 4rem;
  }
  .skill {
    color: var(--skillColor);
    font-weight: var(--fontWeight);
    text-transform: var(--textCase);
  }
</style>
  <h1>Soy DesarroladorC</h1>
  <h2>Esto es nuevo para mi, primera practica q disfruto hacer me mantiene ocupado, aunque cada cosa q hagome imagino como podria hacerle algo a ella, solo se q tenemos q ver hacia el futuro y dejar el pasado atras</h2>

	<p>He aquí algunos datos sobre mí:</p>
<ul>
  <li>Me llamo {identity.firstName}.</li>
  <li>Vivo en {identity.country} y trabajo como {identity.occupation}.</li>
  {identity.hobbies.length >= 2 &&
    <li>Dos de mis aficiones son: {identity.hobbies[0]} y {identity.hobbies[1]}</li>
  }
</ul>
<p>Mis habilidades son:</p>
<ul>
  {skills.map((skill) => <li class="skill">{skill}</li>)}
</ul>
{happy && <p>¡Estoy mejorando para seguir adelante!</p>}

{finished && <p>Me han terminado hace tiempo ya</p>}

{goal === 3 ? <p>Mi objetivo es superarla en 3 meses.</p> : <p>Mi objetivo no son 3 días.</p>}

    </BaseLayout>
    